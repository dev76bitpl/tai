{
  "_readme": [
    "Skopiuj jako .claude/settings.json w katalogu monorepo",
    "Zamień ścieżki na absolutne: /abs/path/to/.claude/hooks/<script>.py",
    "Ścieżki absolutne wymagane gdy CWD sesji != root monorepo"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-commit.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-docs-tests.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-adr.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-ai-template.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-pr.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-template-sync.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard-user-tested.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/suggest-pr.py"
          }
        ]
      }
    ]
  }
}
