{
  "_readme": [
    "Claude Code hooks — AI-specific layer.",
    "Git workflow guards (lint, tests, ADR, user-tested, etc.) live in .pre-commit-config.yaml at repo root.",
    "Copy this file to .claude/settings.json (or .claude/settings.local.json for machine-local overrides).",
    "Windows users: replace 'python3' with 'py' in command entries."
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ai-template.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-template-sync.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/suggest-pr.py"
          }
        ]
      }
    ]
  }
}
