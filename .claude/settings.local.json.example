{
  "_readme": "Per-machine hook commands. Copy to settings.local.json and set correct interpreter: 'python3' on Ubuntu/macOS, 'py' on Windows.",
  "_env_note": "Optional: add 'env' section with ANTHROPIC_API_KEY for per-project API key. See docs/CLAUDE_AUTH.md. Example: \"env\": { \"ANTHROPIC_API_KEY\": \"sk-ant-api03-...\" }",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-process-kill.py"
          },
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ai-template.py"
          },
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-template-sync.py"
          },
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-testing-checklist.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "INTERPRETER ${CLAUDE_PROJECT_DIR}/.claude/hooks/suggest-pr.py"
          }
        ]
      }
    ]
  }
}
